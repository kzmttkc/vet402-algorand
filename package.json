    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.6.3",
    "@x402-avm/extensions": "2.6.1",
    "@x402/avm": "2.11.0",
    "@x402/core": "2.11.0",
    "@x402/fetch": "2.11.0",
    "@x402/hono": "2.11.0",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "author": "Sen"
