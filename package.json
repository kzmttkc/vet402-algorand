  "description": "vet402 on Algorand: pay a downstream x402 endpoint, check delivery against its declaration, return ALLOW/REFUSE with evidence",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keys:gen": "tsx scripts/gen-keys.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "balances": "tsx scripts/balances.ts",
    "server": "tsx src/server.ts",
    "sellers": "tsx src/sellers.ts",
    "demo": "tsx src/client-demo.ts",
    "probe:once": "tsx scripts/probe-once.ts",
    "keys:gen:mainnet": "tsx scripts/gen-payer-mainnet.ts"
  },
  "license": "MIT",
