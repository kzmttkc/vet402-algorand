# ---- network -------------------------------------------------------------
# testnet (default) | mainnet
X402_NETWORK=testnet
# MainNet is locked unless this is exactly "yes" (set only after owner approval)
# I_UNDERSTAND_MAINNET_MOVES_REAL_FUNDS=yes

# ---- who gets paid / who pays --------------------------------------------
# Where customers pay vet402. MainNet default: RMMD7KW5F627Q72AJKNZEIEP33I3RD4VSCBGUSYVUTPZARJ6PDBNPIY33Q
# VET402_PAY_TO=
# Wallet vet402 pays sellers from (SECRET). Locally it lives in .env.<network>.local
# (npm run keys:gen:mainnet). On Vercel set it as an encrypted env var.
# PAYER_MNEMONIC=

# ---- price and caps ------------------------------------------------------
CHECK_PRICE_USDC=0.05
# defaults: testnet 0.04 / 1.00, mainnet 0.10 / 3.00
# PROBE_MAX_PER_CALL_USDC=
# PROBE_MAX_PER_DAY_USDC=

# ---- services ------------------------------------------------------------
FACILITATOR_URL=https://facilitator.goplausible.xyz
# default: https://{testnet,mainnet}-idx.algonode.cloud
# INDEXER_URL=
PORT=4021
PROBE_TIMEOUT_MS=20000
# 1 only for the local TestNet demo (lets vet402 probe localhost sellers). Refused on MainNet.
ALLOW_PRIVATE_TARGETS=0
